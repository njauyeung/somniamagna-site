{
  // Somnia Magna: static site + a small API for owner-only photo posts.
  // Deploys automatically from GitHub (Cloudflare Workers Builds). The name must match the Worker in the dashboard.
  "name": "somniamagna-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "somniamagna", "database_id": "1b84e5cf-4ccb-4b3c-9151-2cbb7af1669e" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "somniamagna-photos" }
  ],
  "vars": {
    // Who may sign in: the two emails, matched against the Access token.
    "OWNER_EMAILS": "njauyeung@gmail.com,kaizen.maclambdas@gmail.com",
    // From Zero Trust: your team domain and the Access application's Audience tag.
    "TEAM_DOMAIN": "https://somniamagna.cloudflareaccess.com",
    "POLICY_AUD": "f96172d40663dddfc069c8e16b7749fec1447eae5d6accd962482217f8ad1243"
  }
}
